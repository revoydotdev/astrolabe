# Operator config for `astrolabe fetch`. Copy to `.env` (already gitignored) and
# `chmod 600` it. Values here are read only by the fetch/CLI path; no MCP tool
# can see them and `astrolabe env` prints them masked.
#
# An exported environment variable of the same name overrides the file.

# --- residential proxy (IPRoyal) -------------------------------------------
# The legacy BASTILLE_RESPROXY_* spelling is also accepted.
ASTROLABE_RESPROXY_USER=
ASTROLABE_RESPROXY_PASS=
ASTROLABE_RESPROXY_GATEWAY=geo.iproyal.com:12321
ASTROLABE_RESPROXY_GEO=_country-us_state-virginia

# --- challenge solver -------------------------------------------------------
ASTROLABE_BYPARR_URL=http://127.0.0.1:8191/v1

# --- VPN egress gate --------------------------------------------------------
# Run when `astrolabe fetch --netns` is used; a non-zero exit refuses the fetch.
ASTROLABE_EGRESS_VERIFY_CMD=/usr/local/sbin/vpn-egress-verify.sh

# --- browser ----------------------------------------------------------------
CLOAKBROWSER_PATH=~/.local/bin/cloakbrowser-chromium
ASTROLABE_BROWSER=auto
