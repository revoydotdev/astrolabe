{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revoydotdev.github.io/astrolabe/schemas/artifact-manifest-v1.schema.json",
  "title": "astrolabe artifact manifest v1",
  "type": "object",
  "required": [
    "schema_version", "artifact_schema_version", "artifact_type", "astrolabe_version",
    "run_id", "target", "completeness", "started_at", "completed_at",
    "parent_artifacts", "artifacts", "adapters", "failures", "truncations", "safety_mode"
  ],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "schema_version": {"const": 1},
    "artifact_schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "astrolabe_version": {"type": "string", "minLength": 1},
    "astrolabe_commit": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "profile": {"type": ["string", "null"]},
    "completeness": {"enum": ["complete", "partial", "failed"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "generated_at": {"type": "string"},
    "parent_artifacts": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "adapters": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "truncations": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "safety_mode": {"type": "string"}
  },
  "additionalProperties": false
}
