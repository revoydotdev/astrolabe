{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revoydotdev.github.io/astrolabe/schemas/discovery-v1.schema.json",
  "title": "astrolabe discovery corpus v1",
  "type": "object",
  "required": ["schema_version", "schema_dialect", "candidate_count", "sources", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "schema_dialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "browser-traffic", "dom-navigation", "service-worker", "js-bundle",
          "source-map", "chunk-manifest", "openapi", "graphql-introspection",
          "graphql-recovery", "observed-error", "robots", "sitemap", "recipe",
          "operator-seed"
        ]
      }
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "coverage": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source", "confidence"],
      "properties": {
        "source": {
          "enum": [
            "browser-traffic", "dom-navigation", "service-worker", "js-bundle",
            "source-map", "chunk-manifest", "openapi", "graphql-introspection",
            "graphql-recovery", "observed-error", "robots", "sitemap", "recipe",
            "operator-seed"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "locator": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["kind", "key", "value", "confidence", "execution_state", "evidence", "metadata"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "execution_state": {"enum": ["inventory-only", "eligible"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
